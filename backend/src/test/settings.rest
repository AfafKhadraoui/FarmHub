@baseUrl = http://localhost:5000

# ==========================================
# SCENARIO A: FARMER (ADMIN)
# ==========================================

# 1. Login
# @name farmerlogin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "user3farmer@gmail.com",
  "password": "Password123!"
}

###
@token = {{farmerlogin.response.body.data.token}}

# 2. Farm Settings
GET {{baseUrl}}/api/settings/farm
Authorization: Bearer {{token}}

###
PUT {{baseUrl}}/api/settings/farm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Green Valley",
  "location": "Oran, Algeria"
}

###
# 3. Notification Preferences
GET {{baseUrl}}/api/settings/notification-preferences
Authorization: Bearer {{token}}

###
PUT {{baseUrl}}/api/settings/notification-preferences
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "taskCompletion": true,
  "taskOverdue": true,
  "newWorkerJoined": false
}

###
